# ==============================================================================
# CRT BOOKS — VARIÁVEIS DE AMBIENTE (.env.example)
# Configure estas variáveis no painel da Vercel (Settings -> Environment Variables)
# NUNCA adicione chaves secretas neste arquivo ou no repositório Git.
# ==============================================================================

# 1. FRONTEND & AUTENTICAÇÃO SUPABASE (Expostas ao build do Vite)
# URL do projeto Supabase (ex: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=""
# Chave pública / anon / publishable do Supabase Auth
VITE_SUPABASE_PUBLISHABLE_KEY=""

# 2. BACKEND SUPABASE (Exclusivas do Servidor / Vercel Serverless — NUNCA usar prefixo VITE_)
# URL do projeto Supabase para uso direto nas funções serverless (opcional se VITE_SUPABASE_URL estiver definida)
SUPABASE_URL=""
# Chave secreta administrativa (service_role / sb_secret_...) usada APENAS no backend (/api/*)
SUPABASE_SERVICE_ROLE_KEY=""

# 3. CREDENCIAIS GOOGLE DRIVE DO ACERVO (Exclusivas do Servidor — NUNCA usar prefixo VITE_)
# JSON completo da Service Account com permissão de leitura nas pastas do acervo no Google Drive
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Chave de API opcional do Google Drive (usada apenas como fallback se não houver Service Account)
GOOGLE_DRIVE_API_KEY=""

# 4. CONTROLE DE ACESSO RESTRITO PARA VERSÃO DE TESTE E ADMINISTRAÇÃO (Exclusivas do Servidor)
# Ativa o bloqueio estrito no backend para que apenas contas de teste autorizadas acessem as rotas privadas
CRT_PRIVATE_TEST_MODE="true"
# Lista de e-mails ou UUIDs autorizados a testar o acervo em validação (status draft / rights_status pending), separados por vírgula
CRT_ALLOWED_TEST_EMAILS=""
CRT_ALLOWED_TEST_USER_IDS=""
# Lista de e-mails ou UUIDs de administradores autorizados nas rotas /api/admin/*, separados por vírgula
CRT_ADMIN_EMAILS=""
CRT_ADMIN_USER_IDS=""
# Opcional: defina como "true" para desativar as contas proprietárias padrão e exigir apenas as listas acima
CRT_DISABLE_DEFAULT_TEST_ACCOUNTS="false"
CRT_DISABLE_DEFAULT_ADMIN_ACCOUNTS="false"
# Opcional: defina como "true" apenas quando lançar o modo comercial público (oculta todas as obras draft/pending)
CRT_PUBLIC_COMMERCIAL_MODE="false"
